{
  "name": "pi-desktop",
  "version": "0.1.0",
  "description": "Native macOS desktop control for Pi agents, backed by the in-process cua-driver SDK",
  "type": "module",
  "exports": "./src/index.ts",
  "files": ["src", "skills", "README.md"],
  "pi": {
    "extensions": ["./src/index.ts"],
    "skills": ["./skills"]
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "bun test test/extension.test.ts && node --test test/pi.test.mjs",
    "test:live": "node --test test/live.test.mjs"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "os": ["darwin"],
  "dependencies": {
    "@trycua/cua-driver": "0.29.1",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.0.0",
    "@earendil-works/pi-coding-agent": "1.0.0",
    "@types/bun": "1.3.14",
    "typescript": "5.9.3"
  }
}
