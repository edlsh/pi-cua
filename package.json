{
  "name": "@edlsh/pi-cua",
  "version": "0.1.0",
  "description": "Native macOS desktop control for Pi agents, backed by the cua-driver CuaDriver.app daemon",
  "type": "module",
  "keywords": ["pi-package", "pi", "pi-coding-agent", "extension", "macos", "desktop", "computer-use", "cua"],
  "author": "Enzo Lucchesi <enzo@edl.sh>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/edlsh/pi-cua.git"
  },
  "bugs": {
    "url": "https://github.com/edlsh/pi-cua/issues"
  },
  "homepage": "https://github.com/edlsh/pi-cua#readme",
  "publishConfig": {
    "access": "public"
  },
  "exports": "./src/index.ts",
  "files": ["src", "skills", "README.md", "LICENSE"],
  "pi": {
    "extensions": ["./src/index.ts"],
    "skills": ["./skills"]
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "bun test test/extension.test.ts && node --test test/pi.test.mjs",
    "test:live": "node --test test/live.test.mjs"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "os": ["darwin"],
  "dependencies": {
    "@trycua/cua-driver": "0.36.0",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@types/bun": "1.4.3",
    "typescript": "5.9.3"
  }
}
